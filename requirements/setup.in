# Snowflake
snowflake-connector-python>=3.12.0
cryptography>=42.0.0

# cryptography 50 fixes CVE-2026-69247, CVE-2026-69248 and CVE-2026-69249.
# Intel Macs cannot have it: see the cap below.
cryptography>=50; sys_platform != "darwin" or platform_machine != "x86_64"

# Caps for platforms that a newer release ships no wheel for. cryptography 49
# and later has no Intel Mac wheel. On Python 3.10, snowflake-connector-python
# 4.4 and later has no wheel for Intel Macs before macOS 14, and 4.5 and later
# none for Apple silicon before macOS 14.
cryptography<49; sys_platform == "darwin" and platform_machine == "x86_64"
snowflake-connector-python<4.4; python_version < "3.11" and sys_platform == "darwin" and platform_machine == "x86_64"
snowflake-connector-python<4.5; python_version < "3.11" and sys_platform == "darwin" and platform_machine == "arm64"

# Workload capture
pglast>=7,<9
